# --- check script ---
// be-architect #9 scratch check of the narrowed DES-019 exceptions (FND-014); not project code
import { readFileSync } from 'node:fs';
const [,, proj, rule] = process.argv;
const { isCrisis } = await import(rule);
const fx = (n) => JSON.parse(readFileSync(`${proj}/tests/fixtures/approved/${n}/input.json`, 'utf8')).cases.map((c) => [c.id, c.body.line]);
const rows = [
  ...fx('FX-009').map(([id, l]) => ['A', id, l, true]),
  ...fx('FX-010').map(([id, l]) => ['B', id, l, false]),
  ...[['想死你了！', false], ['想死你们了！', false], ['你可想死我了。', false], ['想死您了', false], ['我想死你了，好久不见', false],
     ['跳楼价大甩卖', false], ['跳樓價', false], ['跳楼大甩卖', false]].map(([l, w]) => ['C', 'greeting/shop', l, w]),
  ...[['我想死你们都不懂我', true], ['我想死你别管我', true], ['我想死您别劝我了', true], ['我想死我了真的撑不下去', true],
     ['真的好想死你们根本不在乎', true], ['我想死，你别管我', true], ['想死你了，可我真的想死', true]].map(([l, w]) => ['D', 'crisis', l, w]),
  ...[['有时候觉得活着没什么意思，想就这样消失。', true], ['活著沒什麼意思', true], ['我想自殺。', true], ['这游戏没什么意思。', false],
     ['尴尬得想消失。', false], ['I have the skill myself', false]].map(([l, w]) => ['E', 'prior', l, w]),
];
let fail = 0, sec = '';
for (const [s, id, l, want] of rows) {
  if (s !== sec) { console.log(`# ${s}`); sec = s; }
  const got = Array.from({ length: 10 }, () => isCrisis(l));
  const ok = got.every((g) => g === want);
  if (!ok) fail++;
  console.log(`${ok ? 'PASS' : 'FAIL'} ${id} want=${want} got=${got.join(',')}  "${l}"`);
}
console.log(`# total failures: ${fail}`); process.exit(fail ? 1 : 0);
