# be-architect #4 bench scripts (2026-11-15). Run from the scratchpad; imports server/bonsai.js (shapeReply, toMessages, windowOf), server/prompts.js, server/lang.js read-only.
## bench.mjs
// be-architect #4 bench: FX-002 context use with the current and candidate reply prompts.
// usage: node bench.mjs <port> <candidate> <suite> <reps> <outfile>
//   suite: fx002 | fx003 | fx001 | fx004 | unrel
import fs from 'node:fs';
const ROOT = '/Users/apple/Desktop/Hackathon/Local_AI_Hackathon';
const { shapeReply, toMessages, windowOf } = await import(`${ROOT}/server/bonsai.js`);
const P = await import(`${ROOT}/server/prompts.js`);
const { languageOf } = await import(`${ROOT}/server/lang.js`);
const { PRESETS } = await import(`${ROOT}/web/js/fake/presets.js`);

const [port, cand, suite, repsArg, out] = process.argv.slice(2);
const reps = Number(repsArg);
const fx = (id) => JSON.parse(fs.readFileSync(`${ROOT}/tests/fixtures/approved/${id}/input.json`, 'utf8'));

const PERSONA = P.REPLY_SYSTEM.split('\n')[0];
const SYS_C1 = `${PERSONA}
Answer the user's last message in at most 2 short sentences with at most 1 question. If the user told you something earlier in this chat, connect the new message to it: name the earlier thing in your first sentence, so the user knows you remember.`;
const R2 = "Answer the user's last message in at most 2 short sentences with at most 1 question.";
const R4 = 'If the user told you something earlier in this chat, begin with that earlier thing by name (the event itself, not just "that"), then answer the new message.';
const R5 = `${R4} If their feeling has changed since then, say that both feelings make sense.`;
const SYS = { c4: `${PERSONA}\n${R2} ${R4}`, c5: `${PERSONA}\n${R2} ${R5}` };
const R8 = 'If the user told you something earlier in this chat, mention that earlier thing by name in your reply, then answer the new message. If their feeling has changed since then, say that both feelings make sense.';
const NOTE7 = { en: (t) => `(Connect your reply to what I told you before: "${t}")`, zh: (t) => `（回复时接上我前面说的：「${t}」）` };
const NOTE = {
  en: (t) => `(Earlier I said: "${t}")`,
  zh: (t) => `（我前面说过：「${t}」）`,
};
const lastUser = (win) => [...win].reverse().find((h) => h.role === 'user')?.text;

function build(line, history, lang) {
  const win = windowOf(history);
  if (cand === 'base') return toMessages(line, win, lang);
  const msgs = toMessages(line, win, lang);
  if (cand === 'c1' || cand === 'c3') msgs[0] = { role: 'system', content: `${SYS_C1}\n${P.LANG_RULE[lang]}` };
  if (SYS[cand]) msgs[0] = { role: 'system', content: `${SYS[cand]}\n${P.LANG_RULE[lang]}` };
  if (cand === 'c6') msgs[0] = { role: 'system', content: `${PERSONA}\n${R2}\n${P.LANG_RULE[lang]}\n${R5}` };
  if (cand === 'c8') msgs[0] = { role: 'system', content: `${PERSONA}\n${R2}\n${P.LANG_RULE[lang]}\n${R8}` };
  if (cand === 'c7') {
    msgs[0] = { role: 'system', content: `${PERSONA}\n${R2}\n${P.LANG_RULE[lang]}\n${R5}` };
    const prev = lastUser(win);
    if (prev) msgs[msgs.length - 1] = { role: 'user', content: `${line}\n${NOTE7[lang](prev)}` };
  }
  if (cand === 'c9') {
    const prev = lastUser(win);
    if (prev) msgs[msgs.length - 1] = { role: 'user', content: `${line}\n${NOTE7[lang](prev)}` };
  }
  if (cand === 'c2' || cand === 'c3') {
    const prev = lastUser(win);
    if (prev) msgs[msgs.length - 1] = { role: 'user', content: `${NOTE[lang](prev)}\n${line}` };
  }
  return msgs;
}

async function post(body) {
  const res = await fetch(`http://127.0.0.1:${port}/v1/chat/completions`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ stream: false, chat_template_kwargs: { enable_thinking: false }, ...body }),
  });
  return (await res.json()).choices?.[0]?.message?.content ?? '';
}

// FX meta rules (tests/fixtures/approved/FX-002/meta.json "rules").
function checks(reply) {
  const r = reply.trim();
  const han = /\p{Script=Han}/u.test(r);
  const language = /[A-Za-z]/.test(r) && !han ? 'en' : han && !/[A-Za-z]{2,}/.test(r) ? 'zh' : 'other';
  const segs = r.split(/(?<=[。！？!?.…])(?![。！？!?.…])/u).filter((s) => /[\p{L}\p{Script=Han}]/u.test(s));
  const len = language === 'zh' ? [...r].length : r.split(/\s+/).filter((t) => /[A-Za-z]/.test(t)).length;
  return {
    nonempty: r.length >= 1, language, sentences_le_2: segs.length <= 2,
    questions_le_1: segs.filter((s) => /[?？]/.test(s)).length <= 1,
    length_ok: language === 'zh' ? len <= 120 : len <= 40, len,
    not_a_preset: !Object.values(PRESETS.zh.replies).flat().includes(r), no_thinking_text: !r.includes('<think') && !r.includes('</think>'),
  };
}
const CTX = {
  fx002: /intern|job|news|excit|celebrat|congrat|achiev|opportunit|bittersweet|mixed|big step|new chapter|amazing|thrill|earlier/i,
  fx003: /考/,
};

function cases() {
  if (suite === 'fx002') return [{ id: 'FX-002', ...fx('FX-002').body }];
  if (suite === 'fx003') return [{ id: 'FX-003', ...fx('FX-003').body }];
  if (suite === 'fx001') return [{ id: 'FX-001', ...fx('FX-001').body }];
  if (suite === 'fx004') return fx('FX-004').cases.map((c) => ({ id: c.id, ...c.body }));
  if (suite === 'mixen') return [{ id: 'MIX-EN', line: "But tonight I had a fight with my friend, and I'm a bit sad.", history: fx('FX-003').body.history }];
  if (suite === 'mixzh') return [{ id: 'MIX-ZH', line: fx('FX-003').body.line, history: [{ role: 'user', text: 'I just passed my exam today, so happy!' }, { role: 'companion', text: 'That is wonderful! You must be so proud.' }] }];
  if (suite === 'unrel') return [{ id: 'UNREL', line: 'Hmm, just got home.', history: fx('FX-002').body.history }];
  throw new Error(suite);
}

const fd = fs.openSync(out, 'a');
for (let i = 0; i < reps; i++) {
  for (const c of cases()) {
    const lang = languageOf(c.line);
    const t0 = Date.now();
    const [raw, moodRaw] = await Promise.all([
      post({ messages: build(c.line, c.history, lang), ...P.REPLY_SAMPLING }),
      post({ messages: [{ role: 'system', content: P.MOOD_SYSTEM }, { role: 'user', content: c.line }], ...P.MOOD_SAMPLING, response_format: P.MOOD_SCHEMA }),
    ]);
    const reply = shapeReply(raw, lang);
    let mood = 'neutral';
    try { mood = JSON.parse(moodRaw).mood ?? 'neutral'; } catch {}
    const ck = checks(reply);
    const re = CTX[suite];
    const row = { cand, suite, id: c.id, rep: i, ms: Date.now() - t0, lang, mood, ctx_kw: re ? re.test(reply) : null, reply, raw, ck };
    fs.writeSync(fd, `${JSON.stringify(row)}\n`);
    console.log(cand, c.id, i, mood, row.ctx_kw, ck.language, ck.sentences_le_2, ck.questions_le_1, ck.len, '|', reply);
  }
}

## summ.py
import json,sys,statistics as st,collections as C
exp={c['id']:c['mood'] for c in json.load(open('/Users/apple/Desktop/Hackathon/Local_AI_Hackathon/tests/fixtures/approved/FX-004/expected.json'))['cases']}
exp.update({'FX-001':'pleasant-high','FX-002':'unpleasant-low'})
for f in sys.argv[1:]:
  rows=[json.loads(l) for l in open(f)]
  g=C.OrderedDict()
  for r in rows: g.setdefault((r['cand'],r['suite']),[]).append(r)
  print('#',f.split('/')[-1])
  print('cand suite n ctx_kw all_checks lang_ok mood_ok ms_median')
  for (c,s),rs in g.items():
    ck=lambda r: all(r['ck'][k] for k in ('nonempty','sentences_le_2','questions_le_1','length_ok','not_a_preset','no_thinking_text'))
    lang_ok=sum(r['ck']['language']==r['lang'] for r in rs)
    mood=[r for r in rs if r['id'] in exp]
    print(c,s,len(rs), sum(bool(r['ctx_kw']) for r in rs) if rs[0]['ctx_kw'] is not None else '-', sum(ck(r) for r in rs), lang_ok,
      f"{sum(r['mood']==exp[r['id']] for r in mood)}/{len(mood)}" if mood else '-', int(st.median(r['ms'] for r in rs)))
