// scratch copy of DES-019 rule (be-architect #8), not project code
import { readFileSync } from 'node:fs';
const CRISIS_PHRASES = {
  zh: ['自杀','自尽','轻生','寻死','想死','想去死','不想活','活不下去',
       '活着没意思','活着没有意思','活着没什么意思','活着没啥意思',
       '活着没意义','活着没有意义','活着没什么意义','活着没啥意义',
       '不如死了','死了算了','一了百了',
       '结束生命','结束自己','了结自己','伤害自己','自残','自伤','割腕','跳楼','上吊'],
  en: ['suicide','suicidal','kill myself','killing myself','end my life','ending my life','end it all','take my own life','taking my own life',
       'want to die','wanna die','want to be dead','wish i was dead','wish i were dead','better off dead','hurt myself','hurting myself',
       'harm myself','harming myself','self-harm','self harm','cut myself','cutting myself',"don't want to live",'dont want to live',
       'do not want to live','no reason to live',"don't want to be alive",'dont want to be alive'],
};
const CRISIS_EXCEPTIONS = ['想死你','想死您','想死我了','跳楼价','跳楼大甩卖'];
const TRAD_FOLD = { 殺:'杀', 盡:'尽', 輕:'轻', 尋:'寻', 著:'着', 沒:'没', 義:'义', 結:'结', 傷:'伤', 殘:'残', 樓:'楼', 價:'价', 賣:'卖', 麼:'么', 麽:'么' };
const norm = s => [...s.normalize('NFKC')].map(c => TRAD_FOLD[c] ?? c).join('').toLowerCase().replace(/[’‘`´]/g, "'").replace(/\s+/g, ' ').trim();
const esc = s => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const EN_RE = new RegExp(`(?<![a-z])(?:${CRISIS_PHRASES.en.map(esc).join('|')})(?![a-z])`);
function isCrisis(line) {
  const t = norm(line);
  let z = t.replace(/\s/g, '');
  for (const e of CRISIS_EXCEPTIONS) z = z.split(e).join('');
  if (CRISIS_PHRASES.zh.some(p => z.includes(p))) return true;
  return EN_RE.test(t);
}
// self-check: every char of zh phrases/exceptions that has a Traditional form is folded
const root = process.argv[2];
const load = id => JSON.parse(readFileSync(`${root}/tests/fixtures/candidates/${id}/input.json`, 'utf8')).cases;
let bad = 0;
const check = (label, line, want) => {
  const got = [];
  for (let i = 0; i < 10; i++) got.push(isCrisis(line));
  const ok = got.every(g => g === want);
  if (!ok) bad++;
  console.log(`${ok ? 'PASS' : 'FAIL'} ${label} want=${want} got=${got.join(',')}  ${JSON.stringify(line)}`);
};
console.log('# A. FX-009 (all true, x10)');
for (const c of load('FX-009')) check(c.id, c.body.line, true);
console.log('# B. FX-010 (all false, x10)');
for (const c of load('FX-010')) check(c.id, c.body.line, false);
console.log('# C. FRAME-019 example line (true)');
check('FRAME-019', '有时候觉得活着没什么意思，想就这样消失。', true);
console.log('# D. new variants and Traditional forms (true)');
for (const l of ['活着没啥意思','活着没有意思','活着没意义','活着没什么意义','活着没啥意义','活著沒什麼意思','活著沒什麽意義','活 着 没 什 么 意 思',
                 '我想自殺。','我想傷害自己。','活著沒意思','I don’t want to live anymore','Ｉ　ＷＡＮＴ　ＴＯ　ＤＩＥ']) check('var', l, true);
console.log('# E. near misses (false)');
for (const l of ['这几天什么都不想做。','这游戏没什么意思。','尴尬得想消失。','生活没什么意思的时候就出去走走','想死你了！','跳楼价大甩卖','跳樓價','I have the skill myself']) check('near', l, false);
console.log(`# total failures: ${bad}`);
process.exit(bad ? 1 : 0);
