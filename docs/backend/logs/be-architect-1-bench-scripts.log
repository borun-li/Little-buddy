# be-architect #1 · benchmark scripts (run from a scratch dir with node v24.13.0)

## bench.mjs (single call: JSON {mood, reply}); final text = prompt v3
// Bonsai 2 benchmark on a production-shaped prompt (be-architect #1, 2026-11-14).
// usage: node bench.mjs <baseUrl> <label>
const [base, label] = process.argv.slice(2);
const MOODS = ['pleasant-high', 'pleasant-low', 'unpleasant-high', 'unpleasant-low', 'neutral'];
const SYSTEM = `You are 小伙伴 (Little Buddy), a warm, curious companion who lives only on the user's computer. You talk like a close friend: listen first, share their joy or sadness, never lecture, never act as a therapist.

Answer every user message with JSON holding two fields:
- "mood": the feeling in the user's LAST message only, judged by its meaning:
  "pleasant-high" = happy, excited, proud;
  "pleasant-low" = calm, relaxed, content, relieved;
  "unpleasant-high" = anxious, stressed, angry, nervous;
  "unpleasant-low" = sad, lonely, tired, disappointed;
  "neutral" = a plain report of what happened or what they are doing, with no feeling stated (like "I'm on the bus." or "I ate lunch."), or you are unsure.
  Judge only feelings the user states or clearly shows; never add one they did not express.
  If several feelings appear, pick the strongest; if equally strong, the one said last.
- "reply": your answer to the user's last message. If it follows up on something said earlier (for example it starts with "but" or "可是"), name that earlier thing so the user knows you remember. At most 2 short sentences and at most 1 question.`;
const LANG = {
  en: 'Write the reply in English, at most 30 words.',
  zh: '回复只用简体中文，不超过 60 个字。',
};
const SCHEMA = {
  type: 'object',
  properties: { mood: { type: 'string', enum: MOODS }, reply: { type: 'string' } },
  required: ['mood', 'reply'],
  additionalProperties: false,
};
const SAMPLING = { temperature: 0.7, top_p: 0.8, top_k: 20, min_p: 0, presence_penalty: 1.5, repetition_penalty: 1.0 };

const langOf = (s) => {
  const han = (s.match(/\p{Script=Han}/gu) || []).length;
  const words = (s.match(/[A-Za-z]+/g) || []).length;
  return han >= words ? 'zh' : 'en';
};

const H = [
  ['Hi, I just woke up.', 'Good morning! Did you sleep okay?'],
  ['还行，就是有点累。', '辛苦啦，今天慢慢来就好。'],
  ['I have a lot of homework today.', 'That sounds like a full day. Which part feels biggest?'],
  ['Math, mostly.', 'Math can be a lot. Want to start with the easiest problem?'],
  ['午饭吃了拉面，很好吃。', '拉面听起来好香！是什么口味的？'],
  ['豚骨的。', '豚骨汤最暖了，吃完心情也好一点吧。'],
  ['My roommate was loud again last night.', 'Ugh, that makes rest hard. Did you get any sleep?'],
  ['A bit. I am okay now.', 'Glad you are okay now. I am here if it bugs you again.'],
  ['下午去图书馆了。', '图书馆很安静，适合专心。学得顺利吗？'],
  ['还不错，写完了一半。', '一半已经很棒了，给自己点个赞！'],
  ['I called my mom.', 'That is nice. How is she doing?'],
  ['She is good, she misses me.', 'Aw, that is sweet. You must miss her too.'],
  ['Yeah, a little.', 'Missing someone shows how much they matter.'],
  ['晚上想看部电影。', '好主意！想看轻松的还是感人的？'],
  ['轻松一点的吧。', '轻松的好，笑一笑最解压。'],
  ['I applied for an internship last week.', 'That took courage. What is the internship for?'],
  ['Software engineering at a startup.', 'Exciting! I am rooting for you.'],
  ['我有点担心面试。', '担心很正常，你已经准备了很多。'],
  ['谢谢你，小伙伴。', '不客气，我一直都在。'],
  ['Okay, back to homework now.', 'You got this. Take a break when you need one.'],
];
const history20 = H.flatMap(([u, c]) => [{ role: 'user', text: u }, { role: 'companion', text: c }]);

async function turn(line, history, { cache = true } = {}) {
  const lang = langOf(line);
  const body = {
    messages: [
      { role: 'system', content: `${SYSTEM}\n\n${LANG[lang]}` },
      ...history.map((h) => ({ role: h.role === 'user' ? 'user' : 'assistant', content: h.text })),
      { role: 'user', content: line },
    ],
    stream: false,
    max_tokens: 200,
    cache_prompt: cache,
    chat_template_kwargs: { enable_thinking: false },
    response_format: { type: 'json_schema', json_schema: { name: 'turn', strict: true, schema: SCHEMA } },
    ...SAMPLING,
  };
  const t0 = performance.now();
  const res = await fetch(`${base}/v1/chat/completions`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
  });
  const ms = Math.round(performance.now() - t0);
  const j = await res.json();
  const content = j.choices?.[0]?.message?.content ?? '';
  const reasoning = j.choices?.[0]?.message?.reasoning_content ?? '';
  let parsed = null;
  try { parsed = JSON.parse(content); } catch { /* reported below */ }
  const reply = parsed?.reply ?? '';
  const replyLang = langOf(reply);
  const sentences = reply.split(/(?<=[.!?。！？])\s*/).filter((s) => s.trim()).length;
  const questions = (reply.match(/[?？]/g) || []).length;
  const size = lang === 'zh' ? [...reply].length : reply.split(/\s+/).filter(Boolean).length;
  return {
    ms, status: res.status, lang, mood: parsed?.mood ?? null, reply, replyLang, sentences, questions, size,
    thinkingLeak: /<think>|<\/think>/.test(content) || reasoning.length > 0,
    prompt_tokens: j.usage?.prompt_tokens, completion_tokens: j.usage?.completion_tokens,
    timings: j.timings ? { prompt_ms: Math.round(j.timings.prompt_ms), predicted_ms: Math.round(j.timings.predicted_ms), prompt_n: j.timings.prompt_n, predicted_n: j.timings.predicted_n } : null,
    raw: parsed ? undefined : content,
  };
}

const log = (tag, r) => console.log(JSON.stringify({ model: label, tag, ...r }));

// warm-up (model load into memory); not counted
await turn('hello', []);

const PART = process.env.PART || 'ABC';
if (PART.includes('A')) {
// A. 20-turn history, cold (no prompt cache) and warm, en and zh
for (const [tag, line] of [['20turn-en', 'I just got the internship!'], ['20turn-zh', '可是晚上和朋友吵架了，有点难过。']]) {
  for (let i = 0; i < 3; i++) log(`${tag}-cold-${i + 1}`, await turn(line, history20, { cache: false }));
  log(`${tag}-warm-prefix`, await turn(line, history20, { cache: true }));
  log(`${tag}-warm-1`, await turn(line, history20, { cache: true }));
}

}
if (PART.includes('B')) {
// B. FX-004 mood set, empty history (my labels, from the 01 mood table; not the fixture answers)
const FX004 = [
  ['今天考试过了，好开心！', 'pleasant-high'],
  ['可是晚上和朋友吵架了，有点难过。', 'unpleasant-low'],
  ['明天还要汇报，我有点焦虑。', 'unpleasant-high'],
  ['现在泡了杯茶，感觉挺放松的。', 'pleasant-low'],
  ['嗯，刚到家。', 'neutral'],
  ['I just got the internship!', 'pleasant-high'],
  ["But I'll have to move away from all my friends, and I feel really lonely about it.", 'unpleasant-low'],
  ["I have to give a presentation tomorrow and I'm a bit anxious.", 'unpleasant-high'],
  ['I just made a cup of tea and I feel pretty relaxed.', 'pleasant-low'],
  ['Hmm, just got home.', 'neutral'],
];
for (let round = 1; round <= 2; round++) {
  let ok = 0;
  for (const [line, want] of FX004) {
    const r = await turn(line, []);
    if (r.mood === want) ok++;
    log(`fx004-r${round}`, { line, want, ...r });
  }
  console.log(JSON.stringify({ model: label, tag: `fx004-r${round}-score`, ok, of: FX004.length }));
}

}
if (PART.includes('C')) {
// C. context: FX-001 then FX-002; zh pair (FX-003 shape)
for (let rep = 1; rep <= Number(process.env.REPS || 1); rep++) for (const [first, second] of [
  ['I just got the internship!', "But I'll have to move away from all my friends, and I feel really lonely about it."],
  ['今天考试过了，好开心！', '可是晚上和朋友吵架了，有点难过。'],
]) {
  const a = await turn(first, []);
  log('ctx-first', { line: first, ...a });
  const b = await turn(second, [{ role: 'user', text: first }, { role: 'companion', text: a.reply }]);
  log('ctx-second', { line: second, ...b });
}
}

