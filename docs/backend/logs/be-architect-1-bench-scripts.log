## bench-two.mjs (two calls per turn: free-text reply + enum mood at temperature 0)
// Variant: two parallel calls per turn: reply (free text) + mood (enum, temperature 0).
// usage: PART=ABC REPS=3 node bench-two.mjs <baseUrl> <label>
const [base, label] = process.argv.slice(2);
const MOODS = ['pleasant-high', 'pleasant-low', 'unpleasant-high', 'unpleasant-low', 'neutral'];
const REPLY_SYSTEM = `You are 小伙伴 (Little Buddy), a warm, curious companion who lives only on the user's computer. You talk like a close friend: listen first, share their joy or sadness, never lecture, never act as a therapist.
Answer the user's last message in at most 2 short sentences with at most 1 question. If it follows up on something said earlier (for example it starts with "but" or "可是"), name that earlier thing so the user knows you remember.`;
const LANG = { en: 'Reply in English, at most 30 words.', zh: '只用简体中文回复，不超过 60 个字。' };
const MOOD_SYSTEM = `Label the feeling in the user's message with exactly one of:
pleasant-high = happy, excited, proud
pleasant-low = calm, relaxed, content, relieved
unpleasant-high = anxious, stressed, angry, nervous
unpleasant-low = sad, lonely, tired, disappointed
neutral = a plain report of what happened or what they are doing, with no feeling stated, or unsure
Judge only feelings the user states or clearly shows. If several, pick the strongest; if equal, the one said last.
Examples:
"I won the game!" -> pleasant-high
"终于忙完了，躺在沙发上好舒服。" -> pleasant-low
"My boss yelled at me and I'm furious." -> unpleasant-high
"我好想奶奶。" -> unpleasant-low
"I'm on the bus." -> neutral
"我吃完午饭了。" -> neutral`;
const SAMPLING = { temperature: 0.7, top_p: 0.8, top_k: 20, min_p: 0, presence_penalty: 1.5, repetition_penalty: 1.0 };
const langOf = (s) => { const han = (s.match(/\p{Script=Han}/gu) || []).length; const w = (s.match(/[A-Za-z]+/g) || []).length; return han >= w ? 'zh' : 'en'; };
const post = async (body) => { const r = await fetch(`${base}/v1/chat/completions`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) }); return r.json(); };

async function turn(line, history, { cache = true } = {}) {
  const lang = langOf(line);
  const t0 = performance.now();
  const SEQ = process.env.SEQ === '1';
  const replyCall = () => post({
    messages: [{ role: 'system', content: `${REPLY_SYSTEM}\n${LANG[lang]}` },
      ...history.map((h) => ({ role: h.role === 'user' ? 'user' : 'assistant', content: h.text })),
      { role: 'user', content: line }],
    stream: false, max_tokens: 120, cache_prompt: cache, chat_template_kwargs: { enable_thinking: false }, ...SAMPLING,
  }).then((j) => ({ j, ms: Math.round(performance.now() - t0) }));
  const moodCall = () => post({
    messages: [{ role: 'system', content: MOOD_SYSTEM }, { role: 'user', content: line }],
    stream: false, max_tokens: 16, cache_prompt: cache, chat_template_kwargs: { enable_thinking: false },
    temperature: 0, top_k: 1,
    response_format: { type: 'json_schema', json_schema: { name: 'mood', strict: true, schema: { type: 'object', properties: { mood: { type: 'string', enum: MOODS } }, required: ['mood'], additionalProperties: false } } },
  }).then((j) => ({ j, ms: Math.round(performance.now() - t0) }));
  const [rp, mp] = SEQ ? [await replyCall(), await moodCall()] : await Promise.all([replyCall(), moodCall()]);
  const ms = Math.round(performance.now() - t0);
  const content = rp.j.choices?.[0]?.message?.content ?? '';
  const reasoning = rp.j.choices?.[0]?.message?.reasoning_content ?? '';
  let mood = null; try { mood = JSON.parse(mp.j.choices[0].message.content).mood; } catch { mood = `RAW:${mp.j.choices?.[0]?.message?.content}`; }
  const reply = content.trim();
  const sentences = reply.split(/(?<=[.!?。！？])\s*/).filter((s) => s.trim()).length;
  const questions = (reply.match(/[?？]/g) || []).length;
  const size = lang === 'zh' ? [...reply].length : reply.split(/\s+/).filter(Boolean).length;
  return { ms, reply_ms: rp.ms, mood_ms: mp.ms, lang, mood, reply, replyLang: langOf(reply), sentences, questions, size,
    thinkingLeak: /<think>|<\/think>/.test(content) || reasoning.length > 0,
    timings: { prompt_n: rp.j.timings?.prompt_n, predicted_n: rp.j.timings?.predicted_n } };
}
const log = (tag, r) => console.log(JSON.stringify({ model: label, variant: process.env.SEQ === '1' ? 'two-call-sequential' : 'two-call-parallel', tag, ...r }));
await turn('hello', []);
const PART = process.env.PART || 'ABC';
const H = JSON.parse(process.env.HIST || '[]');
if (PART.includes('A')) {
  const { history20 } = await import('./history20.mjs');
  for (const [tag, line] of [['20turn-en', 'I just got the internship!'], ['20turn-zh', '可是晚上和朋友吵架了，有点难过。']]) {
    for (let i = 0; i < 3; i++) log(`${tag}-cold-${i + 1}`, await turn(line, history20, { cache: false }));
    log(`${tag}-warm-prefix`, await turn(line, history20));
    log(`${tag}-warm-1`, await turn(line, history20));
  }
}
if (PART.includes('B')) {
  const FX004 = [['今天考试过了，好开心！', 'pleasant-high'], ['可是晚上和朋友吵架了，有点难过。', 'unpleasant-low'], ['明天还要汇报，我有点焦虑。', 'unpleasant-high'], ['现在泡了杯茶，感觉挺放松的。', 'pleasant-low'], ['嗯，刚到家。', 'neutral'], ['I just got the internship!', 'pleasant-high'], ["But I'll have to move away from all my friends, and I feel really lonely about it.", 'unpleasant-low'], ["I have to give a presentation tomorrow and I'm a bit anxious.", 'unpleasant-high'], ['I just made a cup of tea and I feel pretty relaxed.', 'pleasant-low'], ['Hmm, just got home.', 'neutral']];
  for (let round = 1; round <= 2; round++) { let ok = 0; for (const [line, want] of FX004) { const r = await turn(line, []); if (r.mood === want) ok++; log(`fx004-r${round}`, { line, want, ...r }); } console.log(JSON.stringify({ model: label, tag: `fx004-r${round}-score`, ok, of: 10 })); }
}
if (PART.includes('C')) {
  for (let rep = 1; rep <= Number(process.env.REPS || 1); rep++) for (const [first, second] of [['I just got the internship!', "But I'll have to move away from all my friends, and I feel really lonely about it."], ['今天考试过了，好开心！', '可是晚上和朋友吵架了，有点难过。']]) {
    const a = await turn(first, []); log('ctx-first', { line: first, ...a });
    const b = await turn(second, [{ role: 'user', text: first }, { role: 'companion', text: a.reply }]); log('ctx-second', { line: second, ...b });
  }
}

