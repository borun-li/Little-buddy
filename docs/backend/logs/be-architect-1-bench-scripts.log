## stats.py
import json,sys,statistics as st
def load(p):
    out=[]
    for l in open(p):
        try: out.append(json.loads(l))
        except: pass
    return out
for name in sys.argv[1:]:
    rs=load(name)
    cold=[r['ms'] for r in rs if '-cold-' in r.get('tag','')]
    warm=[r['ms'] for r in rs if '-warm-' in r.get('tag','')]
    scores=[f"{r['ok']}/{r['of']}" for r in rs if r.get('tag','').endswith('-score')]
    turns=[r for r in rs if 'reply' in r]
    lang_ok=sum(1 for r in turns if r['replyLang']==r['lang'])
    over_s=sum(1 for r in turns if r['sentences']>2); over_q=sum(1 for r in turns if r['questions']>1)
    over_len=sum(1 for r in turns if (r['lang']=='zh' and r['size']>120) or (r['lang']=='en' and r['size']>40))
    leak=sum(1 for r in turns if r.get('thinkingLeak'))
    first=[r['ms'] for r in turns if r.get('tag','')=='ctx-first' or r.get('tag','').startswith('fx004')]
    f=lambda xs: f"n={len(xs)} mean={round(st.mean(xs))} min={min(xs)} max={max(xs)}" if xs else "n=0"
    print(name.split('/')[-1]); print('  cold 20-turn ms:',f(cold)); print('  warm 20-turn ms:',f(warm)); print('  empty/short-history turns ms:',f(first))
    print('  FX-004 mood scores:',scores); print(f'  reply language matched: {lang_ok}/{len(turns)}; >2 sentences: {over_s}; >1 question: {over_q}; over length cap: {over_len}; thinking leak: {leak}')
